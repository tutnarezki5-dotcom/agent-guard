{
  "name": "agentguard",
  "version": "0.1.0",
  "private": true,
  "description": "Policy firewall for AI agents that spend money on NEAR: task mandates, counterparty risk, signed and replayable decisions, on-chain enforcement.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsx --test \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\" \"attacks/*.test.ts\"",
    "test:contract": "cargo test --manifest-path contracts/vault-core/Cargo.toml",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "tsx attacks/run.ts",
    "dev": "tsx --env-file-if-exists=.env apps/api/src/server.ts",
    "agent": "tsx --env-file-if-exists=.env apps/agent/src/cli.ts",
    "replay": "tsx --env-file-if-exists=.env apps/api/src/replay-cli.ts",
    "keys:guard": "tsx scripts/gen-guard-key.ts",
    "setup:testnet": "bash scripts/setup-testnet.sh",
    "attack:fc-transfer": "tsx --env-file-if-exists=.env scripts/attack-fc-transfer.ts",
    "vectors": "tsx scripts/gen-test-vectors.ts",
    "check": "pnpm typecheck && pnpm test && pnpm demo && pnpm test:contract",
    "build:standalone": "tsx scripts/build-standalone.ts",
    "start": "tsx apps/api/src/server.ts",
    "testnet:e2e": "bash scripts/testnet-e2e.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "esbuild": "^0.25.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
