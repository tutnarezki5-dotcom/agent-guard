# Copy to .env. Never commit .env.

# sim (default): everything local, vault simulator. testnet: real contract.
EXECUTOR=sim
PORT=8787

# AgentGuard's ed25519 signing seed (base64, 32 bytes). `pnpm keys:guard` creates one.
GUARD_SECRET_KEY=
GUARD_PUBLIC_KEY=

# Bearer token for owner actions (approve, freeze, mandates). Sim mode defaults to dev-owner-token.
OWNER_TOKEN=
# Optional bearer token the agent must present to /v1/check.
AGENT_TOKEN=

# --- testnet only (scripts/setup-testnet.sh fills these) ---
VAULT_CONTRACT_ID=
AGENT_ACCOUNT_ID=
OWNER_ACCOUNT_ID=
# The agent's FUNCTION-CALL key (receiver = vault, methods = request_payment).
AGENT_FC_PUBLIC_KEY=
AGENT_FC_PRIVATE_KEY=
NEAR_RPC_URL=https://rpc.testnet.near.org
# Optional NearBlocks-compatible indexer for account age and tx count. Verify the endpoint in its docs.
INDEXER_URL=
DATA_FILE=data/agentguard.json

# --- optional LLM for the agent (any OpenAI-compatible endpoint, e.g. NEAR AI Cloud) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Agent CLI → API
AGENTGUARD_URL=http://localhost:8787
